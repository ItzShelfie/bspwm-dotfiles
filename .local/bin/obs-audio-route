#!/usr/bin/env bash
# OBS: весь системный аудио идёт в виртуальный микшер, Discord — мимо OBS на колонки.
set -u

MIX='obs-stream-mix'
LATENCY=50  # мс; 10 мс давали щелчки/разрывы на loopback

detect_real() {
  local i r
  for i in $(seq 1 30); do
    r=$(pactl list short sinks 2>/dev/null | awk '{print $2}' |
      grep -E '^alsa_output\.usb-' | grep -v -i microphone | head -n1)
    [ -n "$r" ] && { printf '%s\n' "$r"; return 0; }
    sleep 0.5
  done
  return 1
}

REAL=$(detect_real) || exit 1

ensure_sink() {
  pactl list short sinks 2>/dev/null | awk '{print $2}' | grep -qx "$MIX" && return
  pactl load-module module-null-sink \
    sink_name="$MIX" \
    sink_properties=device.description=OBS-Stream-Mix \
    rate=48000 channels=2 >/dev/null 2>&1
}

ensure_loopback() {
  local ok=0 idx
  while read -r idx _args; do
    case "$_args" in
      *"source=$MIX.monitor"*)
        if printf '%s' "$_args" | grep -Fq "sink=$REAL" &&
           printf '%s' "$_args" | grep -Fq "latency_msec=$LATENCY"; then
          ok=1
        else
          pactl unload-module "$idx" >/dev/null 2>&1
        fi
        ;;
    esac
  done < <(pactl list short modules 2>/dev/null | grep module-loopback)
  [ "$ok" -eq 1 ] && return
  pactl load-module module-loopback \
    source="$MIX.monitor" sink="$REAL" \
    latency_msec="$LATENCY" \
    source_dont_move=true sink_dont_move=true >/dev/null 2>&1
}

route_streams() {
  python3 - "$REAL" "$MIX" <<'PY'
import re, subprocess, sys
real, mix = sys.argv[1:3]

sources = {}
for line in subprocess.check_output(['pactl','list','short','sources'], text=True).splitlines():
    cols = line.split('\t')
    if len(cols) >= 2:
        sources[cols[0]] = cols[1]

out = subprocess.check_output(['pactl','list','sink-inputs'], text=True)
for block in out.split('Sink Input #')[1:]:
    idx = block.splitlines()[0].strip().rstrip(':')
    app = re.search(r'application\.name = "([^"]+)"', block)
    app = app.group(1) if app else ''
    media = re.search(r'media\.name = "([^"]+)"', block)
    media = media.group(1) if media else ''
    low = (app + ' ' + media).lower()
    if 'loopback' in low or 'obs' in low:
        continue
    target = real if ('discord' in low or 'webrtc' in low) else mix
    subprocess.run(['pactl','move-sink-input', idx, target],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

out = subprocess.check_output(['pactl','list','source-outputs'], text=True)
for block in out.split('Source Output #')[1:]:
    idx = block.splitlines()[0].strip().rstrip(':')
    app = re.search(r'application\.name = "([^"]+)"', block)
    app = app.group(1) if app else ''
    media = re.search(r'media\.name = "([^"]+)"', block)
    media = media.group(1) if media else ''
    src = re.search(r'Source: (\d+)', block)
    srcname = sources.get(src.group(1), '') if src else ''
    if 'loopback' in (app + ' ' + media).lower():
        continue
    if app.lower().startswith('obs') and srcname.endswith('.monitor') and srcname != mix + '.monitor':
        subprocess.run(['pactl','move-source-output', idx, mix + '.monitor'],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
PY
}

ensure_sink
ensure_loopback
for _ in $(seq 1 10); do
  pactl set-default-sink "$MIX" 2>/dev/null && break
  sleep 0.5
done
route_streams

# Новые потоки (Discord, браузер, игры) маршрутизируются автоматически.
pactl subscribe 2>/dev/null | while IFS= read -r line; do
  case "$line" in
    *"Event 'new' on sink-input"*|*"Event 'new' on source-output"*) route_streams ;;
  esac
done
