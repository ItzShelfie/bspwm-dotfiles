#!/usr/bin/env python3
import ctypes, ctypes.util, os, sys
name = sys.argv[1].encode() if len(sys.argv) > 1 else b'left_ptr'
libx11 = ctypes.cdll.LoadLibrary(ctypes.util.find_library('X11') or 'libX11.so.6')
libxc  = ctypes.cdll.LoadLibrary(ctypes.util.find_library('Xcursor') or 'libXcursor.so.1')
libx11.XOpenDisplay.restype = ctypes.c_void_p
libx11.XOpenDisplay.argtypes = [ctypes.c_char_p]
libx11.XDefaultRootWindow.restype = ctypes.c_ulong
libx11.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
libxc.XcursorLibraryLoadCursor.restype = ctypes.c_ulong
libxc.XcursorLibraryLoadCursor.argtypes = [ctypes.c_void_p, ctypes.c_char_p]
libx11.XDefineCursor.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_ulong]
libx11.XFlush.argtypes = [ctypes.c_void_p]
d = libx11.XOpenDisplay(os.environ.get('DISPLAY', ':0').encode())
if not d:
    raise SystemExit(1)
root = libx11.XDefaultRootWindow(d)
cur = libxc.XcursorLibraryLoadCursor(d, name)
if not cur:
    cur = libxc.XcursorLibraryLoadCursor(d, b'default')
libx11.XDefineCursor(d, root, cur)
libx11.XFlush(d)
